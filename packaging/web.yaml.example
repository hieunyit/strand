# /etc/strand/web.yaml — cấu hình KHỞI ĐỘNG của Web UI (strand web --config /etc/strand/web.yaml).
# Web UI chỉ chạy với kho metadata PostgreSQL: pipeline (cấu hình + .env mã hóa), mật khẩu admin, token,
# job, audit, cài đặt đều nằm trong DB. File này chỉ giữ: listen/TLS, database.dsn, state_dir (và danh sách
# import cũ). Quyền file: root:strand 0640 (chứa DSN).
#
# Bắt buộc trong môi trường dịch vụ (/etc/strand/web.env): STRAND_WEB_SECRET_KEY (openssl rand -hex 32).
# Bước đầu: strand web init --database-dsn postgres://strand:...@127.0.0.1:5432/strand_web
# Đổi mật khẩu: strand web passwd --config /etc/strand/web.yaml ; token: strand web token --config ...
# Bản cài cũ chạy không có DB: strand web db migrate --config /etc/strand/web.yaml --dsn postgres://...

# Kho metadata PostgreSQL (BẮT BUỘC). STRAND_WEB_DATABASE_DSN trong môi trường thắng giá trị này.
database:
  dsn: postgres://strand:CHANGE_ME@127.0.0.1:5432/strand_web?sslmode=disable
  # audit: both    # db | file | both (mặc định both: DB + bản sao audit.log trong state_dir)

# Địa chỉ bind. Không phải loopback (127.0.0.1, ::1, localhost) thì phải đặt tls_cert và tls_key,
# hoặc allow_plain_http: true (HTTP thường, không mã hoá: chỉ dùng trong mạng tin cậy), ví dụ listen: 0.0.0.0:8080.
listen: 127.0.0.1:8080
# allow_plain_http: true
# tls_cert: /etc/strand/web.crt
# tls_key: /etc/strand/web.key

# Sau reverse proxy TLS (listen loopback, không TLS): đặt true để cookie có cờ Secure,
# và trust_forwarded_for để lấy IP client từ X-Forwarded-For (chỉ khi proxy là tin cậy).
# secure_cookies: true
# trust_forwarded_for: true

# Thư mục ghi audit.log (JSON lines). Mặc định /var/lib/strand-web.
state_dir: /var/lib/strand-web

# NHẬP pipeline từ file có sẵn vào DB (một lần, khi thấy lần đầu); sau đó bản trong DB là nguồn sự thật,
# file trên đĩa chỉ là bản vật chất hóa cho tiến trình strand. Pipeline mới tạo từ Web UI không cần mục này.
# Quét các file cấu hình theo glob (tên pipeline = tên file bỏ .yaml; <name>.env cùng thư mục
# được nhận làm env_file; unit strand@<name> tồn tại thì dùng systemd)...
scan:
  - /etc/strand/*.yaml

# ...và/hoặc khai báo tường minh (thắng scan cùng tên). Có systemd_unit thì dùng systemctl/journalctl;
# không có thì chế độ nền: strand sync -c <config> --background, log/pid mặc định trong resources.spool.path.
# pipelines:
#   - name: orders-sync
#     config: /etc/strand/orders-sync.yaml
#     env_file: /etc/strand/orders-sync.env      # KEY=VALUE, nạp vào môi trường tiến trình con
#     systemd_unit: strand@orders-sync           # bỏ dòng này nếu chạy bằng --background
#   - name: legacy
#     config: /home/strand/legacy.yaml
#     log_file: /var/log/strand/legacy.log        # tùy chọn; mặc định <spool>/strand.log
#     pid_file: /var/lib/strand/legacy/strand.pid
