# Strand compose: sao chép thành .env (cp .env.example .env) rồi sửa. KHÔNG commit .env.

# ---- bắt buộc ----
# Mật khẩu PostgreSQL metadata. Dùng ký tự chữ-số (nó nằm trong DSN dạng URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24

# Khóa mã hóa (AES-256-GCM) cho bí mật của pipeline (.env: mật khẩu nguồn/đích) lưu trong DB. BẮT BUỘC: thiếu
# thì web không khởi động. Sinh: openssl rand -hex 32  (ví dụ giá trị: 64 ký tự hex).
# Mất khóa = không giải mã được bí mật đã lưu trong DB. Giữ khóa NGOÀI bản backup DB.
STRAND_WEB_SECRET_KEY=
# Đổi khóa: đặt khóa MỚI vào STRAND_WEB_SECRET_KEY và khóa CŨ vào biến dưới, `docker compose up -d` (mọi .env
# trong DB được mã hóa lại khi khởi động), rồi xóa biến dưới. Khóa sai mà không có biến dưới: web từ chối khởi động.
STRAND_WEB_SECRET_KEY_PREVIOUS=

# Mật khẩu admin, CHỈ dùng ở lần khởi động đầu khi database chưa có admin (tối thiểu 8 ký tự).
# Để trống: sinh mật khẩu ngẫu nhiên và in MỘT lần trong `docker compose logs web`.
# Đổi sau này: docker compose exec web strand web passwd   (hoặc dùng STRAND_WEB_ADMIN_PASSWORD_FILE với docker secrets)
STRAND_WEB_ADMIN_PASSWORD=

# ---- mạng ----
# Cổng mặc định chỉ publish trên loopback. Dùng reverse proxy HTTPS cùng host hoặc cấu hình TLS trong Strand để bind ra ngoài.
STRAND_WEB_BIND=127.0.0.1
STRAND_WEB_PORT=8080
# HTTP thường (mật khẩu/cookie không mã hóa): chỉ trong mạng tin cậy. Đặt false khi dùng TLS tại web.
STRAND_WEB_ALLOW_PLAIN_HTTP=true
# Sau reverse proxy TLS: cookie cờ Secure + lấy IP client từ X-Forwarded-For (chỉ khi proxy tin cậy).
# Để trống: chỉnh trên trang Settings của web. Đặt true/false: biến môi trường thắng và khóa ô sửa.
STRAND_WEB_SECURE_COOKIES=
STRAND_WEB_TRUST_FORWARDED_FOR=
# TLS ngay tại web (mount cert vào container, xem compose.yaml): đường dẫn TRONG container.
STRAND_WEB_TLS_CERT=
STRAND_WEB_TLS_KEY=

# ---- tài nguyên / build ----
WEB_CPUS=2
WEB_MEMORY=2g
DB_CPUS=1
DB_MEMORY=1g
# Gắn vào `strand version` và tag image.
STRAND_VERSION=dev
