# /etc/systemd/system/strand-web.service
# Web UI của Strand (docs/PLAN-WEB-UI.md, questions/DECISIONS-WEB-UI-2026-11-15.md).
# Chạy cùng user với strand@<name> (KHÔNG root): chỉ quản lý được pipeline mà user này có quyền
# (đọc /etc/strand/<name>.yaml, kết nối admin socket 0700 của chính user, đọc log).
# Cần kho metadata PostgreSQL (database.dsn trong /etc/strand/web.yaml) và STRAND_WEB_SECRET_KEY trong
# /etc/strand/web.env (scripts/install.sh --with-web tạo cả hai). Trước khi bật: strand web init --database-dsn ...
[Unit]
Description=Strand CDC web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=strand
Group=strand
# STRAND_WEB_SECRET_KEY (bắt buộc), tùy chọn STRAND_WEB_DATABASE_DSN thay cho database.dsn trong web.yaml.
EnvironmentFile=/etc/strand/web.env
ExecStart=/usr/local/bin/strand web --config /etc/strand/web.yaml
Restart=on-failure
RestartSec=5
# Chỉ tiến trình web nhận tín hiệu khi stop/restart. Pipeline chế độ nền (strand sync --background) và
# job verify/repair/promote do web sinh ra nằm trong cgroup này nhưng phải sống tiếp qua lần restart:
# web mới nhận nuôi chúng qua pid file. (Mặc định control-group sẽ giết hết.) Hệ quả: dừng hẳn web
# KHÔNG dừng chúng; dừng bằng nút Stop / strand stop. Gỡ gói: preremove tự strand stop.
KillMode=process
# Audit log và trạng thái: /var/lib/strand-web (systemd tạo, thuộc user strand)
StateDirectory=strand-web
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
