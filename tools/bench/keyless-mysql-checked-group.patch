+// Keep the result sets and statement order within database/sql's transaction so
+// cancellation, rollback and the checkpoint use the same transaction owner.
+func (q *stmtQueue) keylessDML(ctx context.Context, table model.TableID, op model.Op, query string, args ...any) error {
+	if q.groupChecks {
+		return q.queueRows(ctx, 1, &checkedMatch{table, op}, query+"; SELECT ROW_COUNT()", args...)
+	}
+	n, err := q.execAffected(ctx, query, args...)
+	if err != nil {
+		return err
+	}
+	if n == 0 {
+		return keylessMissing(table, op)
+	}
+	q.written++
+	return nil
+}
+
+func (q *stmtQueue) execCheckedGroup(ctx context.Context) error {
+	results, err := q.tx.QueryContext(ctx, q.sb.String(), q.args...)
+	if err != nil {
+		return err
+	}
+	defer results.Close()
+	for i, check := range q.checks {
+		if i > 0 && !results.NextResultSet() || !results.Next() {
+			if err := results.Err(); err != nil {
+				return err
+			}
+			return fmt.Errorf("missing result for keyless %s on %s", check.op, check.table)
+		}
+		var n int64
+		if err := results.Scan(&n); err != nil {
+			return err
+		}
+		if n == 0 {
+			return keylessMissing(check.table, check.op)
+		}
+		if n != 1 {
+			return fmt.Errorf("keyless %s on %s affected %d rows", check.op, check.table, n)
+		}
+	}
+	// Drain trailing DML: a later keyed statement may have failed.
+	if results.NextResultSet() {
+		return fmt.Errorf("unexpected result after %d keyless row counts", len(q.checks))
+	}
+	return results.Err()
+}
